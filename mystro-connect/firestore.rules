rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authd(){ return request.auth != null; }
    function admin(){ return authd() && request.auth.token.admin == true; }
    function self(uid){ return authd() && request.auth.uid == uid; }
    function activeUser(){
      return authd() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true;
    }
    function participant(chatId){
      return activeUser() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{uid} {
      allow create: if self(uid);
      allow read: if self(uid) || admin();
      allow update: if self(uid) || admin();
      allow delete: if false;
    }
    match /publicProfiles/{uid} {
      allow read: if authd();
      allow create,update: if self(uid) && activeUser();
      allow delete: if self(uid) || admin();
    }
    match /chats/{chatId} {
      allow create: if activeUser() && request.auth.uid in request.resource.data.participants;
      allow read,update: if participant(chatId);
      allow delete: if false;
      match /messages/{id} {
        allow read: if participant(chatId);
        allow create: if participant(chatId) && request.resource.data.senderId == request.auth.uid;
        allow update,delete: if false;
      }
    }
    match /products/{id} {
      allow read: if authd();
      allow create: if activeUser() && request.resource.data.sellerId == request.auth.uid;
      allow update,delete: if admin() || (activeUser() && resource.data.sellerId == request.auth.uid);
    }
    match /shortVideos/{id} {
      allow read: if authd();
      allow create: if activeUser() && request.resource.data.ownerId == request.auth.uid;
      allow update,delete: if admin() || (activeUser() && resource.data.ownerId == request.auth.uid);
    }
    match /requests/{id} {
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow read: if admin() || (authd() && resource.data.userId == request.auth.uid);
      allow update: if admin();
      allow delete: if false;
    }
    match /moderationCases/{id} {
      allow create: if activeUser() && request.resource.data.reporterId == request.auth.uid;
      allow read,update: if admin();
      allow delete: if false;
    }
  }
}
