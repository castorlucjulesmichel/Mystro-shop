rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function accountActive() { return !('accountStatus' in me().data) || me().data.accountStatus == 'active'; }
    function activeUser() { return signedIn() && accountActive(); }
    function isAdmin() { return activeUser() && me().data.role == 'admin'; }
    function isSeller() { return activeUser() && (me().data.role == 'seller' || isAdmin()); }
    function unchanged(field) { return request.resource.data[field] == resource.data[field]; }
    function validCurrency(c) { return c in ['HTG','USD','EUR','CAD','GBP','DOP','XOF']; }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role in ['buyer','seller']
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.balance == 0
                    && request.resource.data.balances.HTG == 0;
      allow update: if isAdmin() || (activeUser() && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'role','balance','balances','email','createdAt',
                      'accountStatus','blockedAt','blockedBy','deletedAt','deletedBy','unblockedAt','unblockedBy'
                    ]));
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSeller()
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.price is number
                    && request.resource.data.price > 0
                    && request.resource.data.stock is number
                    && request.resource.data.stock >= 1
                    && validCurrency(request.resource.data.currency)
                    && request.resource.data.status == 'active';
      allow update: if activeUser()
                    && (resource.data.sellerId == request.auth.uid || isAdmin())
                    && request.resource.data.sellerId == resource.data.sellerId
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.price is number
                    && request.resource.data.price > 0
                    && request.resource.data.stock is number
                    && request.resource.data.stock >= 0
                    && validCurrency(request.resource.data.currency);
      allow delete: if activeUser() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow get: if activeUser() && (resource.data.buyerId == request.auth.uid
                    || request.auth.uid in resource.data.sellerIds || isAdmin());
      allow list: if activeUser() && (resource.data.buyerId == request.auth.uid
                    || request.auth.uid in resource.data.sellerIds || isAdmin());
      allow create: if false;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status','adminApproval','approvedAt','approvedBy','rejectedAt','rejectedBy','adminNote'
                    ]);
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow get, list: if activeUser() && (resource.data.buyerId == request.auth.uid
                    || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if activeUser()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.productId is string
                    && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
                    && request.resource.data.sellerId == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sellerId
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1500
                    && request.resource.data.buyerName is string
                    && request.resource.data.buyerName.size() <= 120;
      allow update, delete: if activeUser() && (resource.data.buyerId == request.auth.uid || isAdmin());
    }

    match /messages/{messageId} {
      allow read, write: if false;
    }

    match /adminThreads/{userId} {
      allow get: if isAdmin() || (activeUser() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.userId == userId;
      allow delete: if isAdmin();
    }

    match /privateMessages/{messageId} {
      allow read: if isAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (activeUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.threadId == request.auth.uid
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.senderRole == 'client'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && get(/databases/$(database)/documents/adminThreads/$(request.auth.uid)).data.active == true);
      allow update, delete: if false;
    }

    match /manualTransactions/{id} {
      allow get, list: if isAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create: if activeUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.type in ['deposit','withdrawal']
                    && request.resource.data.provider in ['moncash','natcash']
                    && request.resource.data.currency == 'HTG'
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 20
                    && request.resource.data.status == 'pending'
                    && (request.resource.data.type == 'withdrawal'
                        || (request.resource.data.proofDataUrl is string
                            && request.resource.data.proofDataUrl.size() < 900000));
      allow update: if isAdmin()
                    && unchanged('userId')
                    && unchanged('type')
                    && unchanged('provider')
                    && unchanged('amount')
                    && unchanged('currency')
                    && request.resource.data.status in ['pending','approved','rejected'];
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if activeUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /walletTransactions/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.adminId == request.auth.uid
                    && request.resource.data.type in ['admin_manual_deposit','admin_manual_withdrawal']
                    && request.resource.data.amount is number
                    && request.resource.data.grossAmount is number
                    && request.resource.data.grossAmount > 0
                    && validCurrency(request.resource.data.currency)
                    && request.resource.data.status == 'completed';
      allow update, delete: if false;
    }

    match /topups/{id} { allow read, write: if false; }
    match /withdrawals/{id} { allow read, write: if false; }
    match /payoutRequests/{id} {
      allow get, list: if isAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create, delete: if false;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status','approvedAt','approvedBy','rejectedAt','rejectedBy','adminNote'
                    ])
                    && request.resource.data.status in ['pending_review','approved','rejected'];
    }
    match /platform/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
